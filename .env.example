# Каталог данных (SQLite, видео, кадры). Не коммитится.
DATA_DIR=./data

# Пароль на веб-интерфейс (HTTP Basic). Обязателен, если сервер доступен не только с localhost.
APP_PASSWORD=

# Ключ шифрования токенов: python -m app.cli gen-key
TOKEN_ENCRYPTION_KEY=

# --- Meta (этап 2). Пока false: работает ручной импорт. ---
META_API_ENABLED=false
META_APP_ID=
META_APP_SECRET=
# ID конфигурации Facebook Login for Business (рекомендуется вместо списка scope)
META_LOGIN_CONFIG_ID=
META_REDIRECT_URI=http://localhost:8000/meta/callback
GRAPH_API_VERSION=v24.0

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
CLAUDE_ENABLED=true

# Ролик считается выбросом, если просмотры >= OUTLIER_RATIO × медиана аккаунта
OUTLIER_RATIO=2.0
