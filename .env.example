# Файл .env не коммитится (см. .gitignore). Секреты храните только в нём.

# Каталог данных (SQLite, видео, кадры). Не коммитится.
# На Railway: /data (задан в Dockerfile) — путь, куда смонтирован Volume.
DATA_DIR=./data

# Пароль на веб-интерфейс (HTTP Basic). Обязателен для входа через Meta.
APP_PASSWORD=
# Разрешить работу без пароля — только локально (на Railway игнорируется)
ALLOW_NO_PASSWORD=false

# Ключ шифрования токенов: python -m app.cli gen-key
TOKEN_ENCRYPTION_KEY=
# Предыдущие ключи через запятую — только на время ротации (python -m app.cli rotate-key)
TOKEN_ENCRYPTION_KEYS_OLD=

# --- Meta: существующее приложение «Content Intelligence» ---
META_API_ENABLED=false
META_APP_ID=
META_APP_SECRET=
# Configuration ID конфигурации Unified Login (Facebook Login for Business → Configurations)
META_LOGIN_CONFIG_ID=1313415880861047
# Должен ТОЧНО совпадать с «Valid OAuth Redirect URIs» в приложении
# Production: https://incon-production.up.railway.app/meta/callback
META_REDIRECT_URI=https://localhost:8000/meta/callback
# Если входу доступно несколько Instagram-аккаунтов — какой подключать (без @)
META_IG_USERNAME=
GRAPH_API_VERSION=v24.0

# --- Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
CLAUDE_ENABLED=true

# Ролик считается выбросом, если просмотры >= OUTLIER_RATIO × медиана аккаунта
OUTLIER_RATIO=2.0

# --- Запуск (app.serve) ---
# PORT задаёт Railway; локально по умолчанию 8000. HOST: 0.0.0.0 на Railway, иначе 127.0.0.1.
# FORWARDED_ALLOW_IPS: адреса прокси, которым доверяем X-Forwarded-* (на Railway по умолчанию *).
